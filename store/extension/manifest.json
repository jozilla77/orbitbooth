{
  "manifest_version": 3,
  "name": "Orbit Jump",
  "version": "2.0.0",
  "description": "A cute one-tap flying game — guide Orbit across 18 kawaii Thai provinces, grab sparkles for slow-mo, top the leaderboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Play Orbit Jump",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  }
}
